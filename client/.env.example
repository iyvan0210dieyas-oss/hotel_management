# ==============================================================================
# Client Environment Configuration (Vite)
# ==============================================================================

# LOCAL DEVELOPMENT:
# Point to your local Node.js Express server
VITE_API_URL=http://localhost:5001

# PRODUCTION DEPLOYMENT (Vercel):
# Option A (Dedicated Backend on Render / Railway / Fly.io / VPS):
# Set this in Vercel Dashboard -> Project Settings -> Environment Variables:
# VITE_API_URL=https://your-backend-service.onrender.com
#
# Option B (Full-Stack Vercel Serverless Function):
# Leave VITE_API_URL empty so requests use same-origin relative URLs (/api/hotels):
# VITE_API_URL=
