# ==============================================================================
# Server Environment Configuration (Express & PostgreSQL)
# ==============================================================================

PORT=5001
NODE_ENV=production

# Client URL for CORS Whitelisting
CLIENT_URL=https://hotelmanagementiyvan.vercel.app

# ------------------------------------------------------------------------------
# LOCAL POSTGRESQL (Laptop Development):
# ------------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=hotel_management

# ------------------------------------------------------------------------------
# CLOUD POSTGRESQL (Production / Cross-Device Synchronization):
# Use a cloud hosted PostgreSQL provider (Neon.tech, Supabase.com, Render.com)
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/hotel_management?sslmode=require
